RewriteEngine On

# 1. Hide .php extension cleanly
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]

# 2. (Optional) Redirect direct .php requests to the extensionless URL to avoid duplicate content
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/([^.]+)\.php[?\s] [NC]
RewriteRule ^ %1 [R=301,L]